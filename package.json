{
  "name": "codex-resumer",
  "version": "0.1.0",
  "description": "A local daemon for resuming Codex work after usage interruptions",
  "type": "module",
  "bin": {
    "codex-resumer": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "test": "npm run build && node --test 'dist/test/**/*.test.js'",
    "test:cli": "npm run build && node --test dist/test/cli.test.js",
    "test:daemon": "npm run build && node --test dist/test/daemon.test.js",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "smoke:configured": "node scripts/smoke-configured-access.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "better-sqlite3": "12.10.1"
  },
  "allowScripts": {
    "better-sqlite3@12.10.1": true
  }
}
